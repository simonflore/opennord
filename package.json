{
  "name": "opennord",
  "version": "0.1.2",
  "private": false,
  "license": "AGPL-3.0-or-later",
  "description": "Open, AI-native companion for the Nord Stage 4 — browse, share and visualize programs, and (experimental) talk to your Nord directly.",
  "type": "module",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "lint": "eslint src && stylelint \"src/**/*.css\"",
    "lint:fix": "eslint src --fix && stylelint \"src/**/*.css\" --fix",
    "fixtures:scan": "vitest run src/lib/clavia/fixtures-scan.test.ts --reporter=default",
    "hw:test-piano": "esbuild scripts/make-test-piano.ts --bundle --platform=node --format=esm --log-level=warning --outfile=hardware-test/.bin/make-test-piano.mjs && node hardware-test/.bin/make-test-piano.mjs",
    "hw:compare": "esbuild scripts/compare-recording.ts --bundle --platform=node --format=esm --log-level=warning --outfile=hardware-test/.bin/compare-recording.mjs && node hardware-test/.bin/compare-recording.mjs",
    "hw:typecheck": "tsc --noEmit -p scripts/tsconfig.hwtest.json",
    "build:native": "OPENNORD_NATIVE=1 tsc -b && OPENNORD_NATIVE=1 vite build",
    "cap:sync": "npm run build:native && cap sync",
    "build:electron": "cross-env OPENNORD_ELECTRON=1 tsc -b && cross-env OPENNORD_ELECTRON=1 vite build",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:usb --outdir=electron/dist --out-extension:.js=.cjs --banner:js=\"process.env.PREBUILDS_ONLY='1';\"",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron/dist/main.cjs\"",
    "electron:pack": "node scripts/usb-native-guard.mjs clean && npm run build:electron && npm run electron:build && electron-builder --mac --universal --publish never && node scripts/usb-native-guard.mjs verify --target darwin-x64+arm64",
    "electron:pack:win": "node scripts/usb-native-guard.mjs clean && npm run build:electron && npm run electron:build && electron-builder --win --x64 --publish never && node scripts/usb-native-guard.mjs verify --target win32-x64",
    "release:desktop": "node scripts/release-desktop.mjs",
    "icons": "electron scripts/make-icons.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@capacitor/core": "^8.5.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@tanstack/react-router": "^1.170.16",
    "ai": "^6.0.206",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "fflate": "^0.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "usb": "2.17.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitejs/plugin-react": "^6.0.2",
    "capacitor-midi-input": "file:plugins/capacitor-midi-input",
    "capacitor-nord-usb": "file:plugins/capacitor-nord-usb",
    "concurrently": "^9.2.5",
    "cross-env": "^10.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.0",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.10.1",
    "jsdom": "^29.1.1",
    "prettier-plugin-tailwindcss": "^0.6",
    "stylelint": "^17.13.0",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "org.opennord.app",
    "productName": "OpenNord",
    "files": [
      "dist/**/*",
      "electron/dist/**/*",
      "!**/node_modules/usb/build/**"
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "simonflore",
        "repo": "opennord"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "minimumSystemVersion": "13.0",
      "artifactName": "OpenNord-mac.${ext}",
      "hardenedRuntime": true,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "icon": "electron/icon/icon.png",
      "sign": "electron/sign-mac.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon/icon.png"
    },
    "nsis": {
      "perMachine": false,
      "artifactName": "OpenNord-win-x64.${ext}"
    }
  }
}
