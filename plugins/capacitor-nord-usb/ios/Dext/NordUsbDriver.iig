// Compiles against the DriverKit SDK; NOT yet run on hardware — needs an M1+ iPad
// and a Nord to validate.
#ifndef NordUsbDriver_h
#define NordUsbDriver_h

#include <Availability.h>
#include <DriverKit/IOService.iig>
#include <DriverKit/IOUserClient.iig>
#include <USBDriverKit/IOUSBHostInterface.iig>

/// Owns the Nord's vendor interface and its two bulk pipes. The app reaches it
/// through NordUsbUserClient, which calls the LOCALONLY methods below in-process.
class NordUsbDriver: public IOService {
public:
  virtual bool init() override;
  virtual void free() override;
  virtual kern_return_t Start(IOService* provider) override;
  virtual kern_return_t Stop(IOService* provider) override;
  virtual kern_return_t NewUserClient(uint32_t type, IOUserClient** userClient) override;

  /// USB product id of the connected Nord, 0 when it couldn't be read.
  uint16_t ProductId() LOCALONLY;
  /// Write one request frame to bulk OUT.
  kern_return_t BulkOut(const uint8_t* data, uint32_t length) LOCALONLY;
  /// Read one reply frame from bulk IN. `timeoutMs` 0 waits forever. A timeout
  /// with nothing received returns kIOReturnTimeout and `*transferred == 0`.
  kern_return_t BulkIn(uint8_t* data, uint32_t capacity, uint32_t timeoutMs, uint32_t* transferred) LOCALONLY;
};

#endif /* NordUsbDriver_h */
