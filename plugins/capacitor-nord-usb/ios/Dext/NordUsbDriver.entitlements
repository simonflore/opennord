<?xml version="1.0" encoding="UTF-8"?>
<!-- Development signing gets these automatically. Distribution (TestFlight
     included) needs Apple to grant the USB transport entitlement for vendor id
     4092 (0x0FFC) to the team — docs/IPAD.md. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.developer.driverkit</key>
  <true/>
  <key>com.apple.developer.driverkit.transport.usb</key>
  <array>
    <dict>
      <key>idVendor</key>
      <integer>4092</integer>
    </dict>
  </array>
</dict>
</plist>
