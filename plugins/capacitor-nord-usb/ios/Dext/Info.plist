<?xml version="1.0" encoding="UTF-8"?>
<!-- Matches every Clavia device's vendor interface (class 0xFF, subclass 0xFF,
     protocol 0xFF — the maintainers’ notes), not one product id: the app tells the
     models apart from the product id the driver reports. idVendor 4092 = 0x0FFC.
     Only the Stage 4 (pid 0x002E) is hardware-confirmed to use that interface. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>OSBundleUsageDescription</key>
  <string>Moves programs and sounds between this iPad and a connected Nord keyboard.</string>
  <key>IOKitPersonalities</key>
  <dict>
    <key>NordUsbDriver</key>
    <dict>
      <key>CFBundleIdentifier</key>
      <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
      <key>CFBundleIdentifierKernel</key>
      <string>com.apple.kpi.iokit</string>
      <key>IOClass</key>
      <string>IOUserService</string>
      <key>IOProviderClass</key>
      <string>IOUSBHostInterface</string>
      <key>IOUserClass</key>
      <string>NordUsbDriver</string>
      <key>IOUserServerName</key>
      <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
      <key>idVendor</key>
      <integer>4092</integer>
      <key>bInterfaceSubClass</key>
      <integer>255</integer>
      <key>bInterfaceProtocol</key>
      <integer>255</integer>
      <key>UserClientProperties</key>
      <dict>
        <key>IOClass</key>
        <string>IOUserUserClient</string>
        <key>IOUserClass</key>
        <string>NordUsbUserClient</string>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
