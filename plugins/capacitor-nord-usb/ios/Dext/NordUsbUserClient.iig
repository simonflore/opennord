// Compiles against the DriverKit SDK; NOT yet run on hardware — needs an M1+ iPad
// and a Nord to validate (docs/IPAD.md).
#ifndef NordUsbUserClient_h
#define NordUsbUserClient_h

#include <Availability.h>
#include <DriverKit/IOUserClient.iig>

/// The app's door into NordUsbDriver: one external method per NordTransport call.
/// Selectors and argument shapes mirror NordUserClientMethod in
/// ios/Sources/NordUsbConnection.swift — change both together.
class NordUsbUserClient: public IOUserClient {
public:
  virtual bool init() override;
  virtual void free() override;
  virtual kern_return_t Start(IOService* provider) override;
  virtual kern_return_t Stop(IOService* provider) override;
  virtual kern_return_t ExternalMethod(uint64_t selector,
                                       IOUserClientMethodArguments* arguments,
                                       const IOUserClientMethodDispatch* dispatch,
                                       OSObject* target,
                                       void* reference) override;
};

#endif /* NordUsbUserClient_h */
